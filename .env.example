# Copy this file to .env and fill it in. NEVER commit .env.
# Generate the three secrets with:  npm run secrets
# The server refuses to start if a secret is missing or still a placeholder.

# --- Try it without Google (fake calendar + sample people + temporary database)
# DEMO_MODE=true

# --- Where the app runs (the address in your browser)
APP_URL=http://localhost:5173
PORT=3000

# --- Database (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/touchbase

# --- Secrets (from `npm run secrets`)
SESSION_SECRET=replace-with-output-of-npm-run-secrets
TOKEN_ENCRYPTION_KEY=replace-with-output-of-npm-run-secrets
CRON_SECRET=replace-with-output-of-npm-run-secrets

# --- Google sign-in (Google Cloud Console → Credentials → OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Who may sign in (comma separated). Everyone else is turned away.
ALLOWED_EMAILS=you@gmail.com

# --- Optional: AI talking points (leave empty to use the built-in list)
ANTHROPIC_API_KEY=

# --- Optional
# LOG_LEVEL=info
# TRUST_PROXY=1
